NEXT_PUBLIC_IMAGE_PREFIX=https://trx-main.sgp1.cdn.digitaloceanspaces.com
NEXT_PUBLIC_DEFAULT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpbmZvVXNlciI6eyJlbWFpbCI6Imd1ZXN0LmxhbWluQGdtYWlsLmNvbSIsInBob25lIjoiMDk5OTg4ODk5OSIsImZ1bGxuYW1lIjoiR3Vlc3QtTEFNSU4iLCJiaXpmdWxsbmFtZSI6Ikd1ZXN0LUxBTUlOIiwiZ2VuZGVyIjoxLCJiaXJ0aERheSI6bnVsbCwiY29tcGFueSI6eyJfaWQiOiI2MDQ2YmVlNGI1NTUyNTM2OGIxMWM2ZDUiLCJuYW1lIjoiQ8O0bmcgdHkgQ-.gXn7p1J2kX6iI3Jk5qA5f4ve6qDwYDoTxBsKtxLdShA

# OPENAI_API_KEY / ASSISTANT_ID / VECTOR_STORE_ID đã CHUYỂN sang k8s.
# Nguồn duy nhất: trixgo-kubenetes-prod → apps/prod/trixgo-lamin-webapp/values.yaml
#   · OPENAI_API_KEY  → extraSecrets (Secret `trixgo-lamin-webapp`)
#   · ASSISTANT_ID / VECTOR_STORE_ID → extraEnvVars
# Cả ba đều KHÔNG có tiền tố NEXT_PUBLIC_ nên chỉ đọc lúc chạy, phía server
# (utils/ai/openai-service.ts:11-13) — để ở đây không giúp gì cho bản build, chỉ làm lộ khoá.

ANALYZE=false
# Backend s7-data-hub — CHỈ dùng phía server (app/api/uu-dai, app/api/cua-hang) cho trang quét QR nhận
# ưu đãi và cho gian hàng. KHÔNG đặt tiền tố NEXT_PUBLIC_: biến có tiền tố đó bị nướng vào bundle và lộ ra
# trình duyệt.
S7_API_URL=https://app.szen7.com

# S7_STORE_TOKEN — chìa khoá gian hàng (danh mục · voucher · đặt hàng). CỐ Ý KHÔNG CÓ GIÁ TRỊ Ở ĐÂY:
# đây là bí mật, và file này nằm trong git. Nguồn duy nhất là k8s
# (trixgo-kubenetes-prod → apps/prod/trixgo-lamin-webapp/values.yaml → extraSecrets).
# Cấp token: POST /api/v1/store/token trên s7-data-hub (app sale_b2c), một lần cho org Dược phẩm Lamin.
# Chạy máy mình thì đặt trong .env.local (đã nằm trong .gitignore), đừng điền vào đây.
# Thiếu biến này thì /api/cua-hang/* trả 503 `store_unconfigured` — hỏng to và rõ, không hỏng âm thầm.
